# Frontend (safe to expose)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: set to "true" to require HTTPS-only refresh cookies in production
VITE_COOKIE_SECURE=false

# Edge Function secrets (set in Supabase Dashboard → Edge Functions → Secrets)
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_JWT_SECRET=your-jwt-secret
# VAULT_COOKIE_SECRET=long-random-string
# VAULT_COOKIE_SECURE=true
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# UNSPLASH_ACCESS_KEY=
